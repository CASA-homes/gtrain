# Copy to .env.local for local dev, and add the same two values in Vercel → Settings → Environment Variables.
# Both are in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Live scores feed: aflw (default, AFLW 2026) or afl (men's 2027, once AFL Fantasy publishes the 2027 files). Redeploy after changing.
# NEXT_PUBLIC_SCORE_FEED=aflw
